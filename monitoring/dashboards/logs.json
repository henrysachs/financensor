{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Backend Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{service=\"backend\"} | json", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none" }
    },
    {
      "title": "Error Logs (all services)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{service=\"backend\"} | json | level = `ERROR`", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "title": "Log Volume",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(rate({service=~\".+\"}[5m])) by (service)", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "logs/s" } }
    },
    {
      "title": "Requests by Status (from logs)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(rate({service=\"backend\"} | json | status >= 500 [5m]))", "legendFormat": "5xx" },
        { "expr": "sum(rate({service=\"backend\"} | json | status >= 400 | status < 500 [5m]))", "legendFormat": "4xx" },
        { "expr": "sum(rate({service=\"backend\"} | json | status >= 200 | status < 300 [5m]))", "legendFormat": "2xx" }
      ],
      "fieldConfig": { "defaults": { "unit": "logs/s" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["logs", "loki"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Logs - Application",
  "uid": "app-logs"
}
