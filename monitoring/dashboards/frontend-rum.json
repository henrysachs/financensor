    {
      "title": "Frontend Errors",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 2 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{service_name=\"financensor-frontend\"} | json | kind = `exception`", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "title": "Error Count",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({service_name=\"financensor-frontend\"} | json | kind = `exception` [5m]))", "legendFormat": "errors/5m" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2 } } }
    },
    {
      "title": "Log Events by Kind",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({service_name=\"financensor-frontend\"} | json [5m])) by (kind)", "legendFormat": "{{kind}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2, "stacking": { "mode": "normal" } } } }
    },
