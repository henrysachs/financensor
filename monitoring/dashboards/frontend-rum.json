        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "# Frontend RUM (Faro)\nErrors, Web Vitals, Sessions, Performance \u2014 via Grafana Alloy"
      }
    },
    {
      "title": "Frontend Errors",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"financensor-frontend\"} !~ `session_recording` | json | __error__=\"\" | kind = `exception`",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "title": "Error Count",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "count_over_time({service_name=\"financensor-frontend\"} !~ `session_recording` | json | __error__=\"\" | kind = `exception` [5m])",
          "legendFormat": "errors/5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "title": "Events by Kind",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (kind) (count_over_time({service_name=\"financensor-frontend\"} !~ `session_recording` | json | __error__=\"\" | kind != `event` [5m]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "title": "Web Vitals \u2014 LCP (ms)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "avg_over_time({service_name=\"financensor-frontend\"} !~ `session_recording` | json | __error__=\"\" | kind = `measurement` | type = `web-vitals` | lcp != `` | unwrap lcp [$__range])",
          "legendFormat": "LCP",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2500
