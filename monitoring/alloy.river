// Grafana Alloy configuration for Faro frontend observability

faro.receiver "default" {
  server {
    listen_address   = "0.0.0.0"
    listen_port      = 12347
    cors_allowed_origins = ["https://financensor.stammkneipe.dev"]
    api_key          = ""
    max_allowed_payload_size = "10MiB"
    rate_limiting {
      enabled    = true
      rate       = 100
      burst_size = 200
    }
  }

  sourcemaps {
    download = false
    location {
      path                 = "/sourcemaps/*"
      minified_path_prefix = "/assets/"
    }
  }

  output {
    logs   = [loki.process.faro.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// Add service_name label from Faro app name before writing to Loki
loki.process "faro" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      service_name = "financensor-frontend",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
